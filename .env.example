# ALXQuant .env.example
# Copie para .env e preencha com valores reais.
# .env NUNCA vai para o Git.

# === Account Monitor ===
ACCOUNT_MONITOR_MASTER_KEY=coloque-uma-chave-secreta-aqui
ACCOUNT_MONITOR_HOST=0.0.0.0
ACCOUNT_MONITOR_PORT=8400
AM_ONLINE_WARNING_SEC=10
AM_OFFLINE_SEC=30
AM_MAX_TS_SKEW_SEC=60
AM_NONCE_TTL_SEC=120
AM_RATE_LIMIT_PER_SEC=1.0
AM_REQUIRE_HTTPS=0

# === Command Center ===
CC_MASTER_KEY=coloque-uma-chave-secreta-aqui
CC_PORT=8500
CC_HOST=0.0.0.0
CC_ONLINE_WARNING_SEC=10
CC_OFFLINE_SEC=30
CC_MAX_TS_SKEW_SEC=60
CC_NONCE_TTL_SEC=120
CC_RISK_DD_ATTENTION=1.5
CC_RISK_DD_ELEVATED=3.0
CC_RISK_DD_CRITICAL=5.0

# === MT5 ===
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# === API Keys (preencher conforme necessario) ===
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# === VPS SSH (para deploy via GitHub Actions) ===
VPS_HOST=
VPS_USER=
VPS_PORT=22
VPS_SSH_KEY=
