MQL5/Terminal.ico
MQL5/llm-agent/
MQL5/MQL5/Scripts/
MQL5/MQL5/Files/Logs/
MQL5/MQL5/Files/ALX_NewsFilter_ff_thisweek.csv
MQL5/MQL5/Experts/__backup/

# --- Python cache ---
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.python-version

# --- Database files ---
*.db
*.duckdb
*.duckdb.wal

# --- Virtual environments ---
.venv/
venv/

# --- Environment secrets ---
.env
.env.*
!.env.example

# --- Config files with secrets ---
config.json

# --- IDE/Agent config ---
.opencode/
.vscode/
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Data files (runtime, generated) ---
data/*
!data/schedules.json
!data/agents_status.json

# --- Generated charts and reports ---
data/mql5/_charts/
data/mql5/charts/
data/report/
data/miner_report_*
data/logs/
data/state/
data/.risk_engine.lock
data/account_monitor_keys.json
data/cc-state.json
data/cc-keys.json

# --- Old/unused modules ---
QuantCore/Modulos/_old_not_used/
QuantCore/Modulos/asset_dna/__old/
QuantCore/Modulos/agent_tasks.json

# --- Demo/prototype ---
MT5_Demo_UI_Agent_v0_1/

# --- Build artifacts ---
build/
dist/
node_modules/

# --- CommandCenter ---
CommandCenter/node_modules/
CommandCenter/dist/
CommandCenter/.env
CommandCenter/data/

# --- MQL5 sub-module artifacts ---
MQL5/MQL5/.git/
MQL5/MQL5/Profiles/
MQL5/MQL5/Shared Projects/
MQL5/MQL5/Scripts/UnitTests/
MQL5/MQL5/Scripts/Examples/

# --- Generated docs ---
docs/
reports/

# --- Cache ---
data/cache/
**/.cache/

# --- Binary test cache ---
*.hcc
*.tst
*.opt
*.report

# --- Logs ---
*.log
_srverr.txt
_srvout.txt

# --- Backup archives ---
*.zip
Backup - ALXQuant - 15-08-2026.zip

# --- Local repo backups (bare clones, pre-delete safety copies) ---
_repo_backups/

# --- Agents runtime data (code in QuantCore/Modulos/agents/ is tracked) ---
QuantCore/Modulos/agents/data/

# --- MQL5 Profiles specific files ---
MQL5/MQL5/experts.dat
