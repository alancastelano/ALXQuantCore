# --- MT5 build artifacts ---
*.ex5
*.ex4
*.mq4
MQL5/MQL5/Indicators/MQL4/

# --- MT5 infrastructure ---
MQL5_DEV/
MQL5/Bases/
MQL5/Config/
MQL5/logs/
MQL5/Profiles/
MQL5/Sounds/
MQL5/temp/
MQL5/Tester/
